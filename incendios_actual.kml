    <Style id="red">
      <IconStyle>
        <scale>1.0</scale>
        <Icon>
          <href>https://andreasolanorosique-lab.github.io/Incendios-Espana-v2/icons/fire_red.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0</scale>
      </LabelStyle>
    </Style>
    <Style id="area_amarilla">
      <LineStyle>
        <color>ff00ffff</color>
        <width>2</width>
      </LineStyle>
      <PolyStyle>
        <color>5500ffff</color>
      </PolyStyle>
    </Style>
  </Document>
