<?xml version='1.0' encoding='utf-8'?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Incendios activos España</name>
    <Style id="pink">
      <IconStyle>
        <scale>1.0</scale>
        <Icon>
          <href>https://andreasolanorosique-lab.github.io/Incendios-Espana-v2/icons/fire_pink.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0</scale>
      </LabelStyle>
    </Style>
    <Style id="green">
      <IconStyle>
        <scale>1.0</scale>
        <Icon>
          <href>https://andreasolanorosique-lab.github.io/Incendios-Espana-v2/icons/fire_green.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0</scale>
      </LabelStyle>
    </Style>
    <Style id="yellow">
      <IconStyle>
        <scale>1.0</scale>
        <Icon>
          <href>https://andreasolanorosique-lab.github.io/Incendios-Espana-v2/icons/fire_yellow.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0</scale>
      </LabelStyle>
    </Style>
    <Style id="orange">
      <IconStyle>
        <scale>1.0</scale>
        <Icon>
          <href>https://andreasolanorosique-lab.github.io/Incendios-Espana-v2/icons/fire_orange.png</href>
        </Icon>
      </IconStyle>
      <LabelStyle>
        <scale>0</scale>
      </LabelStyle>
